{
  "Comment": "Leave Management Workflow",
  "StartAt": "StoreTaskToken",
  "States": {
    "StoreTaskToken": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StoreTaskTokenLambdaArn}",
        "Payload": {
          "requestId.$": "$.requestId",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "Next": "SendApprovalEmail"
    },
    "SendApprovalEmail": {
      "Type": "Task", 
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SendApprovalEmailLambdaArn}",
        "Payload": {
          "requestId.$": "$.requestId",
          "userId.$": "$.userId",
          "userEmail.$": "$.userEmail",
          "approverId.$": "$.approverId",
          "leaveDetails.$": "$.leaveDetails",
          "actionType": "APPROVER_REQUEST"
        }
      },
      "Next": "WaitForApproval"
    },
    "WaitForApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem.waitForTaskToken",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "requestId": {"S.$": "$.requestId"}
        }
      },
      "Next": "CheckApprovalResult"
    },
    "CheckApprovalResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "Approved",
          "Next": "SendApprovalNotification"
        }
      ],
      "Default": "SendRejectionNotification"
    },
    "SendApprovalNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SendUserApprovalNotificationLambdaArn}",
        "Payload": {
          "recipientEmail.$": "$.userEmail",
          "subject": "Leave Request Approved",
          "bodyHtml": "Your leave request has been approved!",
          "bodyText": "Your leave request has been approved!",
          "actionType": "USER_APPROVAL"
        }
      },
      "End": true
    },
    "SendRejectionNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke", 
      "Parameters": {
        "FunctionName": "${SendUserRejectionNotificationLambdaArn}",
        "Payload": {
          "recipientEmail.$": "$.userEmail",
          "subject": "Leave Request Rejected",
          "bodyHtml": "Your leave request has been rejected.",
          "bodyText": "Your leave request has been rejected.",
          "actionType": "USER_REJECTION"
        }
      },
      "End": true
    }
  }
}