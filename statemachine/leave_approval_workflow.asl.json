{
  "Comment": "Leave Management Workflow for Human Approval",
  "StartAt": "SendApprovalRequestAndAwaitApproval",
  "States": {
    "SendApprovalRequestAndAwaitApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${SendApprovalEmailLambdaArn}",
        "Payload": {
          "requestId.$": "$.requestId",
          "userId.$": "$.userId",
          "userEmail.$": "$.userEmail",
          "approverId.$": "$.approverId",
          "approverEmail.$": "$.approverEmail",
          "leaveDetails.$": "$.leaveDetails",
          "actionType": "APPROVER_REQUEST",
          "taskToken.$": "$$.Task.Token",
          "apiGatewayUrl": "${APIGatewayUrl}"
        }
      },
      "TimeoutSeconds": 86000, 
      "ResultPath": "$.approvalResult",
      "Next": "CheckApprovalResult",
      "Catch": [
        {
          "ErrorEquals": ["States.TaskFailed", "LeaveRejected"],
          "Next": "SendRejectionNotification",
          "ResultPath": "$.error"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleWorkflowFailure",
          "ResultPath": "$.error"
        }
      ]
    },

    "CheckApprovalResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.approvalResult.status",
          "StringEquals": "Approved",
          "Next": "SendApprovalNotification"
        }
      ],
      "Default": "SendRejectionNotification"
    },

    "SendApprovalNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SendUserApprovalNotificationLambdaArn}",
        "Payload": {
          "recipientEmail.$": "$.userEmail",
          "subject": "Leave Request Approved",
          "bodyHtml.$": "States.Format('<p>Hello,</p><p>Your leave request from {} to {} has been approved.</p>', $.leaveDetails.startDate, $.leaveDetails.endDate)",
          "bodyText.$": "States.Format('Your leave request from {} to {} has been approved.', $.leaveDetails.startDate, $.leaveDetails.endDate)",
          "actionType": "USER_APPROVAL",
          "status.$": "$.approvalResult.status"
        }
      },
      "End": true
    },

    "SendRejectionNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SendUserRejectionNotificationLambdaArn}",
        "Payload": {
          "recipientEmail.$": "$.userEmail",
          "subject": "Leave Request Rejected",
          "bodyHtml.$": "States.Format('<p>Hello,</p><p>Your leave request from {} to {} was rejected.</p>', $.leaveDetails.startDate, $.leaveDetails.endDate)",
          "bodyText.$": "States.Format('Your leave request from {} to {} was rejected.', $.leaveDetails.startDate, $.leaveDetails.endDate)",
          "actionType": "USER_REJECTION",
          "status": "Rejected"
        }
      },
      "End": true
    },

    "HandleWorkflowFailure": {
      "Type": "Pass",
      "End": true,
      "Parameters": {
        "error.$": "$.error",
        "message": "Workflow encountered an unhandled error."
      }
    }
  }
}
